{
  "compilerOptions": {
    "isolatedModules": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2021",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "esModuleInterop": true,
    "types": ["node", "jest", "emscripten"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*"]
}
